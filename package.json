{
  "name": "meditrack",
  "version": "1.0.0",
  "private": true,
  "description": "MediTrack: hospital records and AI-assisted triage on PostgreSQL + pgvector (DBMS Level 3 project)",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "next start -p 3210",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose --env-file .env.local up -d --wait",
    "db:down": "docker compose --env-file .env.local down",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:reset": "tsx --env-file=.env.local scripts/migrate.ts --drop",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "setup": "npm run db:up && npm run db:reset && npm run db:seed",
    "test": "tsx --env-file=.env.local --test --test-reporter=spec tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@huggingface/transformers": "3.8.1",
    "@tanstack/react-query": "5.105.0",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
