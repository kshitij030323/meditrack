# ---- Database (docker-compose reads these too) ----
POSTGRES_USER=meditrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meditrack
POSTGRES_PORT=5433
DATABASE_URL=postgresql://meditrack:change-me@localhost:5433/meditrack

# Read-only login role used by the SQL console (created by the migration script)
DB_READER_PASSWORD=change-me-too
DATABASE_READER_URL=postgresql://meditrack_reader:change-me-too@localhost:5433/meditrack

# ---- Auth (NextAuth) ----
NEXTAUTH_URL=http://localhost:3210
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ---- AI ----
# Sentence-transformer used for all 384-dim embeddings (runs locally, no API key)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# auto = Anthropic if ANTHROPIC_API_KEY is set, else Ollama if reachable, else extractive fallback
LLM_PROVIDER=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Demo data ----
# Password given to every seeded account (stored only as bcrypt hashes in the DB)
DEMO_PASSWORD=choose-a-demo-password
# Show one-click demo logins on the sign-in page
DEMO_MODE=true
